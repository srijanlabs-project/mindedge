rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUserAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ------------------ ENTITY VALIDATORS ------------------
    
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['parent', 'student', 'therapist', 'school_admin', 'admin'];
    }

    function isValidStudent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.sport is string && data.sport.size() <= 128 &&
             data.competitionLevel is string && data.competitionLevel.size() <= 128;
    }

    function isValidTherapist(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.qualification is string && data.qualification.size() <= 512 &&
             data.specialization is string && data.specialization.size() <= 512 &&
             data.sessionFee is int && data.sessionFee >= 0;
    }

    function isValidSchool(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.schoolName is string && data.schoolName.size() <= 256 &&
             data.contactPerson is string && data.contactPerson.size() <= 128;
    }

    function isValidAppointment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.therapistId is string && data.therapistId.size() <= 128 &&
             data.bookerId is string && data.bookerId.size() <= 128 &&
             data.studentName is string && data.studentName.size() <= 128 &&
             data.date is string && data.date.size() <= 128 &&
             data.timeSlot is string && data.timeSlot.size() <= 128 &&
             data.status in ['requested', 'confirmed', 'completed', 'cancelled', 'rescheduled'];
    }

    function isValidPayment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.paymentId is string && data.paymentId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.appointmentId is string && data.appointmentId.size() <= 128 &&
             data.amount is int && data.amount > 0 &&
             data.status in ['success', 'failed'];
    }

    function isValidBlog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 50000 &&
             (data.authorId == request.auth.uid || data.authorId in ['seed-therapist-1', 'seed-therapist-2', 'seed-therapist-3']) &&
             data.category in ['competition_anxiety', 'focus_concentration', 'parent_guidance', 'focus_&_concentration', 'mental_fitness', 'athlete_development'];
    }

    function isValidJournal(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.studentId == request.auth.uid &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 10000;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.message is string && data.message.size() <= 1024 &&
             data.read is bool;
    }

    // ------------------ COLLECTION RULES ------------------

    // 1. Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && isValidUser(incoming()) && incoming().role == existing().role) ||
        isUserAdmin()
      );
      allow delete: if isUserAdmin();
    }

    // 2. Students
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(incoming());
      // For updates, check parentId/studentId immutability
      allow update: if isSignedIn() && isValidStudent(incoming());
      allow delete: if isSignedIn();
    }

    // 3. Therapists
    match /therapists/{therapistId} {
      allow read: if true; // Public therapist discovery
      allow create: if isSignedIn() && (therapistId == request.auth.uid || therapistId in ['seed-therapist-1', 'seed-therapist-2', 'seed-therapist-3']) && isValidTherapist(incoming());
      allow update: if isSignedIn() && (
        (therapistId == request.auth.uid && isValidTherapist(incoming())) ||
        isUserAdmin()
      );
      allow delete: if isUserAdmin();
    }

    // 4. Schools
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && schoolId == request.auth.uid && isValidSchool(incoming());
      allow update: if isSignedIn() && schoolId == request.auth.uid && isValidSchool(incoming());
      allow delete: if isUserAdmin();
    }

    // 5. Appointments
    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidAppointment(incoming());
      allow delete: if isUserAdmin();
    }

    // 6. Payments
    match /payments/{paymentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPayment(incoming());
      allow update: if isUserAdmin();
      allow delete: if isUserAdmin();
    }

    // 7. Blogs
    match /blogs/{blogId} {
      allow read: if true; // Blogs are public reading material
      allow create: if isSignedIn() && isValidBlog(incoming());
      allow update: if isSignedIn() && isValidBlog(incoming());
      allow delete: if isSignedIn();
    }

    // 8. Journals
    match /journals/{journalId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isUserAdmin());
      allow create: if isSignedIn() && isValidJournal(incoming());
      allow update: if isSignedIn() && isValidJournal(incoming());
      allow delete: if isSignedIn() && (resource.data.studentId == request.auth.uid || isUserAdmin());
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 10. Chats
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // 11. Transcripts
    match /transcripts/{transcriptId} {
      allow read, write: if isSignedIn();
    }
  }
}
